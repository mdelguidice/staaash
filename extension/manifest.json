{
  "manifest_version": 3,
  "name": "Stash",
  "version": "1.0.0",
  "description": "Save the current page to Stash",
  "permissions": ["activeTab"],
  "host_permissions": ["http://localhost:3847/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
